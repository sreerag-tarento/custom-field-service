{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "customFieldId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["masterList"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "organisationId": {
      "type": "string",
      "minLength": 1
    },
    "isMandatory": {
      "type": "boolean"
    },
    "attributeName": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "type": "string",
      "minLength": 1
    },
    "isEnabled": {
      "type": "boolean"
    },
    "customFieldData": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["attributeName", "level"],
        "properties": {
          "attributeName": { "type": "string" },
          "level": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "required": [
    "customFieldId",
    "type",
    "name",
    "organisationId",
    "attributeName",
    "isMandatory",
    "customFieldData",
    "isEnabled"
  ],
  "additionalProperties": false
}